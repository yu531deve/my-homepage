---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOCIAL_LINKS } from "../consts";
---

<BaseLayout title="Contact">
  <div class="mx-auto max-w-3xl px-6 py-24">
    <h1 class="text-fg text-4xl font-bold tracking-tight">Contact</h1>
    <p class="text-fg-muted mt-4">お問い合わせは以下のSNSからお願いします。</p>

    <div class="mt-8 flex flex-col gap-4">
      {
        SOCIAL_LINKS.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-fg hover:text-accent-bright border-border rounded-lg border px-6 py-4 text-xl font-medium transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

