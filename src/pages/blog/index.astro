---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BLOG_TAG_LABELS, withBase } from "../../consts";

const posts = (
  await getCollection("blog", ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormatter = new Intl.DateTimeFormat("ja-JP", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<BaseLayout title="Blog">
  <div class="mx-auto max-w-3xl px-6 py-24">
    <h1 class="text-fg text-4xl font-bold tracking-tight">Blog</h1>

    <ul class="mt-12 flex flex-col gap-6">
      {
        posts.map((post) => (
          <li class="border-border border-b pb-6">
            <a href={withBase(`/blog/${post.id}`)} class="hover:text-accent-bright">
              <time datetime={post.data.date.toISOString()} class="text-fg-subtle text-sm">
                {dateFormatter.format(post.data.date)}
              </time>
              <h2 class="text-fg text-xl font-bold">{post.data.title}</h2>
              <p class="text-fg-muted mt-2 text-sm">{post.data.summary}</p>
              <div class="mt-2 flex gap-2">
                {post.data.tags.map((tag) => (
                  <span class="text-accent text-xs">#{BLOG_TAG_LABELS[tag]}</span>
                ))}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
