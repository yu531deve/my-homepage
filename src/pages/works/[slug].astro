---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const works = await getCollection("works");
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { Content } = await render(work);

const linkLabels = {
  repo: "リポジトリ",
  site: "サイトを見る",
  article: "記事",
} as const;
---

<BaseLayout title={work.data.title} description={work.data.summary}>
  <div class="mx-auto max-w-3xl px-6 py-24">
    <a href="/works" class="text-fg-subtle hover:text-accent text-sm">← Works</a>

    <header class="mt-6">
      <h1 class="text-fg text-4xl font-bold tracking-tight">{work.data.title}</h1>
      <p class="text-fg-muted mt-4">{work.data.summary}</p>
      {work.data.period && <p class="text-fg-subtle mt-2 text-sm">{work.data.period}</p>}

      <ul class="mt-4 flex flex-wrap gap-2">
        {
          work.data.tech.map((tech) => (
            <li class="bg-surface-2 text-fg-subtle rounded px-2 py-0.5 text-xs">{tech}</li>
          ))
        }
      </ul>

      <div class="mt-6 flex flex-wrap gap-3">
        {
          Object.entries(linkLabels).map(([key, label]) => {
            const href = work.data.links[key as keyof typeof linkLabels];
            return (
              href && (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border-border hover:border-accent hover:text-accent-bright rounded border px-4 py-2 text-sm transition-colors"
                >
                  {label}
                </a>
              )
            );
          })
        }
      </div>
    </header>

    <hr class="border-border my-10" />

    <article class="prose-dark">
      <Content />
    </article>
  </div>
</BaseLayout>
