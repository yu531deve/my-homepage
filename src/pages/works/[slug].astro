---
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return [
    { params: { slug: "diary" } },
    { params: { slug: "ptcg-card-explorer" } },
    { params: { slug: "ptcg-ai-arena" } },
  ];
}

const { slug } = Astro.params;
---

<BaseLayout title={slug ?? ""}>
  <div class="mx-auto max-w-3xl px-6 py-24">
    <h1 class="text-fg text-4xl font-bold tracking-tight">{slug}</h1>
    <p class="text-fg-muted mt-4">
      作品の概要・使用技術・スクリーンショット・リンクをここに掲載する。
    </p>
  </div>
</BaseLayout>

