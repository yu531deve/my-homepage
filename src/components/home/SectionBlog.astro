---
import type { CollectionEntry } from "astro:content";
import { BLOG_TAG_LABELS } from "../../consts";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat("ja-JP", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<section id="blog" class="relative min-h-screen overflow-hidden px-6 py-24 md:h-screen md:py-0">
  <div class="scene-inner relative mx-auto flex h-full w-full max-w-5xl flex-col justify-center">
    <div class="blog-heading-block">
      <h2 class="blog-heading text-fg text-[16vw] leading-none font-bold md:text-[10vw]">Blog</h2>
    </div>
    <div class="blog-cards mt-12 grid gap-6 [perspective:1000px] md:grid-cols-3">
      {
        posts.map((post) => (
          <a
            class="blog-card border-border bg-surface/60 hover:border-accent block rounded-lg border p-6 backdrop-blur-sm transition-colors duration-[var(--duration-fast)]"
            href={`/blog/${post.id}`}
          >
            <time datetime={post.data.date.toISOString()} class="text-fg-subtle text-sm">
              {dateFormatter.format(post.data.date)}
            </time>
            <h3 class="text-fg mt-2 text-lg font-bold">{post.data.title}</h3>
            <p class="text-fg-muted mt-2 text-sm">{post.data.summary}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="text-accent text-xs">#{BLOG_TAG_LABELS[tag]}</span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
    <a href="/blog" class="text-accent-bright mt-10 inline-block text-sm hover:underline">
      記事一覧へ →
    </a>
  </div>
</section>
