---
import type { CollectionEntry } from "astro:content";

interface Props {
  works: CollectionEntry<"works">[];
}

const { works } = Astro.props;
---

<section
  id="works"
  class="hit-layer relative min-h-screen overflow-hidden px-6 py-24 md:h-screen md:px-0 md:py-0"
>
  <div
    class="works-inner scene-inner relative flex h-full w-full flex-col gap-6 md:block"
    style="perspective: 1200px; transform-style: preserve-3d;"
  >
    <h2
      class="works-heading gl-text text-fg pointer-events-none relative mb-10 text-4xl leading-none font-bold md:absolute md:inset-0 md:mb-0 md:flex md:items-center md:justify-center md:text-[22vw] md:opacity-[0.08]"
      style="-webkit-text-stroke: 1px currentColor;"
      data-gl-anchor="works-heading"
      aria-hidden="true"
    >
      WORKS
    </h2>
    <div
      class="works-stage flex flex-col gap-6 md:absolute md:inset-0 md:flex md:items-center md:justify-center"
    >
      {
        works.map((work, i) => (
          <a
            class="work-card gl-hit border-border bg-surface/60 hover:border-accent relative w-full rounded-lg border p-6 backdrop-blur-sm transition-colors duration-[var(--duration-fast)] md:absolute md:w-[min(60vw,44rem)]"
            href={`/works/${work.id}`}
            data-index={i}
            data-gl-hit={`works-${i}`}
          >
            <span
              class="work-card__index gl-text text-fg pointer-events-none absolute -top-6 -left-2 text-[10vw] leading-none font-bold opacity-[0.12] select-none md:block"
              data-gl-anchor={`works-${i}-index`}
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="gl-text text-fg text-xl font-bold" data-gl-anchor={`works-${i}-title`}>
              {work.data.title}
            </h3>
            <p class="gl-text text-fg-muted mt-2 text-sm" data-gl-anchor={`works-${i}-summary`}>
              {work.data.summary}
            </p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {work.data.tech.map((tech) => (
                <li class="bg-surface-2 text-fg-subtle rounded px-2 py-0.5 text-xs">{tech}</li>
              ))}
            </ul>
            <p class="gl-text sr-only" data-gl-anchor={`works-${i}-tech`}>
              {work.data.tech.join(" · ")}
            </p>
          </a>
        ))
      }
      <a
        class="work-card works-more gl-hit gl-text border-border bg-surface/60 hover:border-accent relative flex w-full items-center justify-center rounded-lg border p-6 text-center backdrop-blur-sm transition-colors duration-[var(--duration-fast)] md:absolute md:w-[min(60vw,44rem)]"
        href="/works"
        data-index={works.length}
        data-gl-hit="works-more"
        data-jp
        data-gl-anchor="works-more-label"
      >
        <span class="text-fg text-lg font-bold">すべての作品を見る →</span>
      </a>
    </div>
  </div>
</section>
