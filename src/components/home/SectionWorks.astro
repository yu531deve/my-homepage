---
import type { CollectionEntry } from "astro:content";

interface Props {
  works: CollectionEntry<"works">[];
}

const { works } = Astro.props;
---

<section id="works" class="relative">
  <div class="works-pin overflow-hidden md:flex md:h-screen md:items-center">
    <div
      class="works-track grid gap-6 px-6 py-24 will-change-transform md:flex md:w-max md:gap-8 md:px-[10vw] md:py-0"
    >
      <div class="works-intro w-full shrink-0 md:w-[70vw] lg:w-[40vw]">
        <h2 class="text-fg text-4xl font-bold md:text-6xl">Works</h2>
        <p class="text-fg-muted mt-4 max-w-md text-lg leading-relaxed">
          これまで制作したプロジェクトの一部です。企画・設計・実装まで自分の手で形にしています。
        </p>
      </div>
      {
        works.map((work) => (
          <a
            class="work-card border-border bg-surface/60 hover:border-accent w-full shrink-0 rounded-lg border p-6 backdrop-blur-sm transition-colors duration-[var(--duration-fast)] md:w-[80vw] lg:w-[34vw]"
            href={`/works/${work.id}`}
          >
            <h3 class="text-fg text-xl font-bold">{work.data.title}</h3>
            <p class="text-fg-muted mt-2 text-sm">{work.data.summary}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {work.data.tech.map((tech) => (
                <li class="bg-surface-2 text-fg-subtle rounded px-2 py-0.5 text-xs">{tech}</li>
              ))}
            </ul>
          </a>
        ))
      }
      <a
        class="works-more border-border bg-surface/60 hover:border-accent flex w-full shrink-0 items-center justify-center rounded-lg border p-6 text-center backdrop-blur-sm transition-colors duration-[var(--duration-fast)] md:w-[60vw] lg:w-[24vw]"
        href="/works"
      >
        <span class="text-fg text-lg font-bold">すべての作品を見る →</span>
      </a>
    </div>
  </div>
</section>
