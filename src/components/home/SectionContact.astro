---
import { SOCIAL_LINKS } from "../../consts";
---

<section
  id="contact"
  class="relative flex min-h-[80vh] flex-col items-center justify-center gap-10 px-6"
>
  <h2
    class="contact-heading text-fg text-center text-[clamp(3rem,13vw,11rem)] leading-none font-bold tracking-[-0.03em]"
  >
    LET'S TALK
  </h2>
  <div class="contact-links flex flex-wrap items-center justify-center gap-6">
    {
      SOCIAL_LINKS.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="border-border bg-surface/60 hover:border-accent hover:text-accent-bright text-fg rounded-full border px-6 py-3 text-sm font-medium backdrop-blur-sm transition-colors duration-[var(--duration-fast)]"
        >
          {link.label}
        </a>
      ))
    }
    <a
      href="/contact"
      class="border-border bg-surface/60 hover:border-accent hover:text-accent-bright text-fg rounded-full border px-6 py-3 text-sm font-medium backdrop-blur-sm transition-colors duration-[var(--duration-fast)]"
    >
      お問い合わせ
    </a>
  </div>
</section>
