---
import { NAV_ITEMS, SITE_TITLE, withBase } from "../consts";

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<header class="border-border bg-base/70 sticky top-0 z-50 border-b backdrop-blur" data-site-header>
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href={withBase("/")} class="text-fg text-lg font-bold tracking-tight">
      {SITE_TITLE}
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="メイン">
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "text-sm transition-colors",
              isActive(item.href) ? "text-accent" : "text-fg-muted hover:text-fg",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      class="text-fg-muted hover:text-fg -mr-2 flex h-10 w-10 items-center justify-center rounded transition-colors md:hidden"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-toggle
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 22 22"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="3" y1="7" x2="19" y2="7"></line>
        <line x1="3" y1="15" x2="19" y2="15"></line>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    class="border-border hidden border-t md:hidden"
    aria-label="メイン(モバイル)"
    data-mobile-nav
  >
    <ul class="mx-auto flex max-w-5xl flex-col px-6 py-2">
      {
        NAV_ITEMS.map((item) => (
          <li class="border-border/60 border-b last:border-b-0">
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "block py-4 text-base transition-colors",
                isActive(item.href) ? "text-accent" : "text-fg-muted hover:text-fg",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const nav = document.querySelector<HTMLElement>("[data-mobile-nav]");

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("hidden", !open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    // Escape で閉じ、開閉ボタンにフォーカスを戻す
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });

    // md 以上に広がったら開いた状態を解除しておく
    const desktop = window.matchMedia("(min-width: 768px)");
    desktop.addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
